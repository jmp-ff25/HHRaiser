[Unit]
Description=HHRaiser Telegram control bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hhraiser
EnvironmentFile=/opt/hhraiser/.env
ExecStart=/opt/hhraiser/.venv/bin/hh-resume-raiser-bot
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
