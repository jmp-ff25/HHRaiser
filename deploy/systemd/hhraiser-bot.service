[Unit]
Description=HHRaiser Telegram control bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=@PROJECT_DIR@/.env
# Серверная служба управляет системными unit-файлами, независимо от локального .env.
Environment=HHRAISER_BOT_USER_SYSTEMD=false
ExecStart=@PROJECT_DIR@/.venv/bin/hh-resume-raiser-bot
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
