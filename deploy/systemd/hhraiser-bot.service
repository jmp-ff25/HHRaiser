[Unit]
Description=HHRaiser Telegram control bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=@PROJECT_DIR@/.env
# Параметр ниже имеет приоритет над HHRAISER_BOT_USER_SYSTEMD в .env.
ExecStart=@PROJECT_DIR@/.venv/bin/hh-resume-raiser-bot --systemd-mode system
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
