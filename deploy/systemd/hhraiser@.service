[Unit]
Description=HHRaiser instance %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
Environment=PYTHONUNBUFFERED=1
Environment=HHRAISER_LOG_COLOR=true
ExecStart=@PROJECT_DIR@/.venv/bin/hh-resume-raiser --headless --full-activity --resume-index-refresh --telegram-captcha --config-file state/%i/hh-config.ini --profile-dir state/%i/browser-profile
KillSignal=SIGINT
TimeoutStopSec=60
Restart=no
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
