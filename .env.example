# Секреты HHRaiser. Скопируйте файл в .env и заполните значения.
# .env исключён из Git и не должен передаваться третьим лицам.

# Учётные данные HH.ru.
HH_PHONE=
HH_PASSWORD=

# Токен Telegram-бота, созданный через @BotFather.
HHRAISER_BOT_TOKEN=
HHRAISER_BOT_ALLOWED_USER_IDS=
HHRAISER_BOT_LOG_LINES=25
# В минутах; 0 отключает периодические сводки.
HHRAISER_BOT_SUMMARY_INTERVAL_MINUTES=360
HHRAISER_BOT_USER_SYSTEMD=true

# Имена управляемых экземпляров через пробел или запятую.
HHRAISER_BOT_INSTANCES=main
HHRAISER_INSTANCE_MAIN_NAME=Основное резюме
HHRAISER_INSTANCE_MAIN_SERVICE=hhraiser@main.service
HHRAISER_INSTANCE_MAIN_STATE_DIR=state/main
HHRAISER_INSTANCE_MAIN_CONFIG_FILE=state/main/hh-config.ini

# Ключ Polza AI для автоматического распознавания CAPTCHA.
HHRAISER_POLZA_API_KEY=

# Отдельный ключ Polza AI для платной оценки вакансий. Разрешите ему
# deepseek/deepseek-v4.1-flash и установите лимит расходов в кабинете Polza.
HHRAISER_MATCHING_API_KEY=
